#:import dp kivy.metrics.dp

<HomeScreen>:
    recent_list: recent_list
    empty_state: empty_state
    doc_count_label: doc_count_label
    bottom_nav_container: bottom_nav_container

    MDFloatLayout:
        md_bg_color: 0.97, 0.98, 1, 1

        MDBoxLayout:
            orientation: "vertical"
            size_hint: 1, 1
            pos_hint: {"x": 0, "y": 0}

            MDBoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: dp(100)
                padding: dp(18), dp(12), dp(18), dp(6)
                md_bg_color: 0.97, 0.98, 1, 1

                MDTextField:
                    id: search_field
                    hint_text: "Search"
                    mode: "rectangle"
                    icon_right: "magnify"
                    size_hint_y: None
                    height: dp(56)
                    on_text: root.refresh_documents(self.text.strip() or None)

            MDBoxLayout:
                orientation: "vertical"
                padding: dp(18), 0, dp(18), dp(4)
                size_hint_y: None
                height: dp(34)

                MDLabel:
                    id: doc_count_label
                    text: "0 documents"
                    theme_text_color: "Secondary"
                    font_style: "Caption"

            ScrollView:
                do_scroll_x: False

                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    padding: dp(10), dp(4)
                    spacing: dp(4)

                    # Empty state: one vertically stacked, horizontally centred
                    # group. The icon is wrapped in an AnchorLayout and given an
                    # explicit size because MDIcon sizes itself to its glyph -
                    # inside a BoxLayout it stayed pinned to the left edge while
                    # the labels below it were centred.
                    MDBoxLayout:
                        id: empty_state
                        orientation: "vertical"
                        size_hint_y: None
                        height: dp(240)
                        padding: dp(8), dp(48), dp(8), 0
                        spacing: dp(10)

                        AnchorLayout:
                            anchor_x: "center"
                            anchor_y: "center"
                            size_hint_y: None
                            height: dp(76)

                            MDIcon:
                                icon: "file-document-outline"
                                theme_text_color: "Hint"
                                font_size: "58sp"
                                size_hint: None, None
                                size: dp(72), dp(72)
                                text_size: self.size
                                halign: "center"
                                valign: "middle"

                        MDLabel:
                            text: "No documents yet"
                            halign: "center"
                            theme_text_color: "Hint"
                            font_style: "H6"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDLabel:
                            text: "Tap the camera button to scan your first page"
                            halign: "center"
                            theme_text_color: "Hint"
                            font_style: "Caption"
                            size_hint_y: None
                            height: self.texture_size[1]
                            text_size: self.width, None

                    MDList:
                        id: recent_list

            # BottomNavigationBar draws its own divider + top shadow, so the bar
            # no longer merges into the page background.
            MDBoxLayout:
                id: bottom_nav_container
                orientation: "vertical"
                size_hint_y: None
                height: dp(82)

        MDFloatingActionButton:
            icon: "camera"
            md_bg_color: 0.05, 0.52, 0.46, 1
            # Keep the scan FAB above the centre of the bottom bar.  It used to
            # sit over the Settings cell (center_x 0.875) and intercepted taps,
            # which made Settings look completely unresponsive.
            pos_hint: {"center_x": 0.5, "y": (bottom_nav_container.height + dp(16)) / max(root.height, dp(1))}
            on_release: root.start_scan()


<DocumentListItem>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(76)
    padding: dp(12), dp(4)
    spacing: dp(12)

    MDIcon:
        icon: root.type_icon
        theme_text_color: "Custom"
        text_color: 0.05, 0.52, 0.46, 1
        size_hint_x: None
        width: dp(42)
        pos_hint: {"center_y": 0.5}

    MDBoxLayout:
        orientation: "vertical"

        MDLabel:
            text: root.doc_name
            font_style: "Subtitle1"
            shorten: True
            shorten_from: "right"
            theme_text_color: "Custom"
            text_color: 0.05, 0.09, 0.17, 1

        MDLabel:
            text: root.doc_meta
            theme_text_color: "Secondary"
            font_style: "Caption"

    MDIconButton:
        icon: "dots-vertical"
        on_release: root.open_menu(self)
