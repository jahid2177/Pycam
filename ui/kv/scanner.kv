#:import dp kivy.metrics.dp

<ScannerScreen>:
    camera_container: camera_container
    permission_box: permission_box
    shutter_button: shutter_button
    hint_label: hint_label
    auto_ring: auto_ring

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0, 0, 0, 1

        # ------------------------------------------------------------
        # Full camera preview.
        # Top controls are OVER the preview like the supplied reference.
        # ------------------------------------------------------------
        FloatLayout:
            id: camera_container

            # Top-left close button
            MDIconButton:
                icon: "close"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                user_font_size: "31sp"
                size_hint: None, None
                size: dp(56), dp(56)
                pos_hint: {"x": 0.02, "top": 0.985}
                on_release: root.close_scanner()
                canvas.before:
                    Color:
                        rgba: 0, 0, 0, 0.58
                    Ellipse:
                        pos: self.pos
                        size: self.size

            # Right-side camera actions: Flash / Enhance / HD / More
            MDBoxLayout:
                orientation: "horizontal"
                adaptive_width: True
                size_hint_y: None
                height: dp(58)
                spacing: dp(7)
                pos_hint: {"right": 0.985, "top": 0.985}

                MDIconButton:
                    icon: "flash" if root.flash_on else "flash-off"
                    theme_text_color: "Custom"
                    text_color: (0.10, 0.92, 0.72, 1) if root.flash_on else (1, 1, 1, 1)
                    user_font_size: "27sp"
                    size_hint: None, None
                    size: dp(54), dp(54)
                    on_release: root.toggle_flash()
                    canvas.before:
                        Color:
                            rgba: 0, 0, 0, 0.58
                        Ellipse:
                            pos: self.pos
                            size: self.size

                MDIconButton:
                    icon: "creation"
                    theme_text_color: "Custom"
                    text_color: (0.10, 0.92, 0.72, 1) if root.enhance_on else (1, 1, 1, 1)
                    user_font_size: "27sp"
                    size_hint: None, None
                    size: dp(54), dp(54)
                    on_release: root.toggle_enhance()
                    canvas.before:
                        Color:
                            rgba: 0, 0, 0, 0.58
                        Ellipse:
                            pos: self.pos
                            size: self.size

                MDCard:
                    orientation: "vertical"
                    size_hint: None, None
                    size: dp(56), dp(56)
                    radius: [dp(28)]
                    elevation: 0
                    md_bg_color: (0.05, 0.78, 0.70, 1) if root.hd_mode else (0, 0, 0, 0.58)

                    MDFlatButton:
                        text: "HD"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        bold: True
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}
                        on_release: root.toggle_hd()

                MDIconButton:
                    icon: "dots-vertical"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1
                    user_font_size: "27sp"
                    size_hint: None, None
                    size: dp(54), dp(54)
                    on_release: root.open_more()
                    canvas.before:
                        Color:
                            rgba: 0, 0, 0, 0.58
                        Ellipse:
                            pos: self.pos
                            size: self.size

            # Center hint pill
            MDCard:
                orientation: "horizontal"
                size_hint: 0.60, None
                height: dp(50)
                pos_hint: {"center_x": 0.5, "top": 0.885}
                radius: [dp(25)]
                elevation: 0
                md_bg_color: 0.05, 0.07, 0.12, 0.78
                line_color: 0.38, 0.45, 0.62, 0.72
                padding: dp(14), 0
                spacing: dp(8)

                MDIcon:
                    icon: "scan-helper"
                    theme_text_color: "Custom"
                    text_color: 0.86, 0.88, 0.93, 1
                    size_hint_x: None
                    width: dp(28)

                MDLabel:
                    id: hint_label
                    text: "Point at document & hold steady"
                    halign: "center"
                    valign: "middle"
                    theme_text_color: "Custom"
                    text_color: 0.92, 0.93, 0.96, 1
                    font_style: "Body2"

            MDBoxLayout:
                id: permission_box
                orientation: "vertical"
                size_hint: 0.86, None
                height: dp(170)
                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                spacing: dp(14)
                padding: dp(16)
                opacity: 0
                disabled: True
                md_bg_color: 0.08, 0.08, 0.08, 0.94

                MDLabel:
                    text: "Camera permission is needed to scan documents"
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1

                MDRaisedButton:
                    text: "GRANT PERMISSION"
                    pos_hint: {"center_x": 0.5}
                    on_release: root.request_permission()

        # ------------------------------------------------------------
        # Bottom scanner controls
        # ------------------------------------------------------------
        MDBoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: dp(190)
            padding: dp(10), dp(4), dp(10), dp(8)
            spacing: dp(2)
            md_bg_color: 0, 0, 0, 1

            MDBoxLayout:
                orientation: "horizontal"
                adaptive_width: True
                size_hint_y: None
                height: dp(34)
                spacing: dp(4)
                pos_hint: {"center_x": 0.5}

                MDRectangleFlatButton:
                    text: "Single"
                    theme_text_color: "Custom"
                    text_color: (0.20, 0.85, 0.35, 1) if root.capture_mode == "single" else (0.75, 0.75, 0.75, 1)
                    line_color: (0.20, 0.85, 0.35, 1) if root.capture_mode == "single" else (0.25, 0.25, 0.25, 1)
                    on_release: root.select_capture_mode("single")

                MDRectangleFlatButton:
                    text: "Batch"
                    theme_text_color: "Custom"
                    text_color: (0.20, 0.85, 0.35, 1) if root.capture_mode == "batch" else (0.75, 0.75, 0.75, 1)
                    line_color: (0.20, 0.85, 0.35, 1) if root.capture_mode == "batch" else (0.25, 0.25, 0.25, 1)
                    on_release: root.select_capture_mode("batch")

            MDBoxLayout:
                orientation: "horizontal"
                adaptive_width: True
                size_hint_y: None
                height: dp(34)
                spacing: dp(20)
                pos_hint: {"center_x": 0.5}

                MDFlatButton:
                    text: "Scan"
                    theme_text_color: "Custom"
                    text_color: (0.20, 0.85, 0.35, 1) if root.scan_type == "scan" else (0.72, 0.72, 0.72, 1)
                    on_release: root.select_scan_type("scan")

                MDFlatButton:
                    text: "ID Cards"
                    theme_text_color: "Custom"
                    text_color: (0.20, 0.85, 0.35, 1) if root.scan_type == "id_card" else (0.72, 0.72, 0.72, 1)
                    on_release: root.select_scan_type("id_card")

            MDBoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: dp(112)
                padding: dp(4), dp(3)
                spacing: dp(4)

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_x: 1.25
                    spacing: dp(2)

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: 0

                        MDIconButton:
                            icon: "image-outline"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            user_font_size: "25sp"
                            pos_hint: {"center_x": 0.5}
                            on_release: root.pick_image()

                        MDLabel:
                            text: "Images"
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: 0.82, 0.82, 0.82, 1
                            font_style: "Caption"

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: 0

                        MDIconButton:
                            icon: "folder-outline"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            user_font_size: "25sp"
                            pos_hint: {"center_x": 0.5}
                            on_release: root.pick_pdf()

                        MDLabel:
                            text: "Files"
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: 0.82, 0.82, 0.82, 1
                            font_style: "Caption"

                FloatLayout:
                    size_hint_x: 1

                    Widget:
                        id: auto_ring
                        size_hint: None, None
                        size: dp(88), dp(88)
                        pos_hint: {"center_x": 0.5, "center_y": 0.52}
                        canvas:
                            Color:
                                rgba: 0.12, 0.88, 0.67, 0.96
                            Line:
                                circle: (self.center_x, self.center_y, self.width / 2 - dp(2), -90, -90 + 360 * root.ring_progress)
                                width: dp(3)
                                cap: "round"

                    MDFloatingActionButton:
                        id: shutter_button
                        icon: "camera"
                        md_bg_color: 1, 1, 1, 1
                        theme_text_color: "Custom"
                        text_color: 0, 0, 0, 1
                        user_font_size: "32sp"
                        disabled: root.capture_busy
                        pos_hint: {"center_x": 0.5, "center_y": 0.52}
                        on_release: root.capture()

                FloatLayout:
                    size_hint_x: 1.25

                    MDLabel:
                        text: root.page_count_text
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        halign: "center"
                        valign: "middle"
                        pos_hint: {"center_x": 0.5, "center_y": 0.52}
