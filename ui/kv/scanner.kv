#:import dp kivy.metrics.dp

<ScannerScreen>:
    camera_container: camera_container
    permission_box: permission_box
    shutter_button: shutter_button
    flash_button: flash_button
    hint_label: hint_label
    top_bar: top_bar
    auto_ring: auto_ring

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0, 0, 0, 1

        MDTopAppBar:
            id: top_bar
            title: "Scan Document"
            elevation: 0
            md_bg_color: 0, 0, 0, 1
            specific_text_color: 1, 1, 1, 1
            left_action_items: [["arrow-left", lambda x: root.close_scanner()]]
            right_action_items: [["flash-off", lambda x: root.toggle_flash()], ["timer-outline", lambda x: root.toggle_auto_capture()]]

        FloatLayout:
            id: camera_container
            # DocumentCamera (Preview) is added here at runtime once we
            # know the camera provider is available on this platform.

            MDLabel:
                id: hint_label
                text: "Point the camera at a document"
                halign: "center"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                size_hint: 1, None
                height: dp(32)
                pos_hint: {"center_x": 0.5, "top": 0.98}
                canvas.before:
                    Color:
                        rgba: 0, 0, 0, 0.35
                    Rectangle:
                        pos: self.pos
                        size: self.size

            MDBoxLayout:
                id: permission_box
                orientation: "vertical"
                size_hint: 0.85, None
                height: dp(160)
                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                spacing: dp(12)
                opacity: 0
                disabled: True

                MDLabel:
                    text: "Camera permission is needed to scan documents"
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1

                MDRaisedButton:
                    text: "GRANT PERMISSION"
                    pos_hint: {"center_x": 0.5}
                    on_release: root.request_permission()

        MDBoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(110)
            padding: dp(24), dp(16)
            md_bg_color: 0, 0, 0, 1

            Widget:

            MDIconButton:
                id: flash_button
                icon: "image-multiple-outline"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                pos_hint: {"center_y": 0.5}
                on_release: root.go_to_pages()

            Widget:

            FloatLayout:
                size_hint: None, None
                size: dp(88), dp(88)
                pos_hint: {"center_y": 0.5}

                Widget:
                    id: auto_ring
                    size_hint: 1, 1
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                    canvas:
                        Color:
                            rgba: 0.20, 0.85, 0.35, 0.95
                        Line:
                            circle: (self.center_x, self.center_y, self.width / 2 - dp(2), -90, -90 + 360 * root.ring_progress)
                            width: dp(3)
                            cap: "round"

                MDFloatingActionButton:
                    id: shutter_button
                    icon: "camera"
                    md_bg_color: 1, 1, 1, 1
                    theme_text_color: "Custom"
                    text_color: 0, 0, 0, 1
                    user_font_size: "32sp"
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                    on_release: root.capture()

            Widget:

            MDLabel:
                text: root.page_count_text
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                halign: "center"
                pos_hint: {"center_y": 0.5}

            Widget:
