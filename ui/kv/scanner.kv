#:import dp kivy.metrics.dp

<ScannerScreen>:
    camera_container: camera_container
    permission_box: permission_box
    shutter_button: shutter_button
    hint_label: hint_label
    auto_ring: auto_ring

    MDFloatLayout:
        md_bg_color: 0, 0, 0, 1

        # Camera preview fills the entire screen
        FloatLayout:
            id: camera_container
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}

            canvas.before:
                Color:
                    rgba: 0, 0, 0, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            # --- Top Controls ---
            MDIconButton:
                icon: "close"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                user_font_size: "30sp"
                size_hint: None, None
                size: dp(52), dp(52)
                pos_hint: {"x": 0.02, "top": 0.985}
                on_release: root.close_scanner()
                canvas.before:
                    Color:
                        rgba: 0, 0, 0, 0.42
                    Ellipse:
                        pos: self.pos
                        size: self.size

            MDBoxLayout:
                orientation: "horizontal"
                adaptive_width: True
                size_hint_y: None
                height: dp(52)
                spacing: dp(22)
                pos_hint: {"right": 0.97, "top": 0.985}

                # Plain icons, no circle background
                MDIconButton:
                    icon: "flash" if root.flash_on else "flash-off"
                    theme_text_color: "Custom"
                    text_color: (0.10, 0.92, 0.72, 1) if root.flash_on else (1, 1, 1, 1)
                    user_font_size: "25sp"
                    size_hint: None, None
                    size: dp(46), dp(46)
                    on_release: root.toggle_flash()

                MDIconButton:
                    icon: "creation"
                    theme_text_color: "Custom"
                    text_color: (0.10, 0.92, 0.72, 1) if root.enhance_on else (1, 1, 1, 1)
                    user_font_size: "25sp"
                    size_hint: None, None
                    size: dp(46), dp(46)
                    on_release: root.toggle_enhance()

                # HD keeps its filled circle (it's a toggle pill, not a plain icon)
                MDCard:
                    orientation: "vertical"
                    size_hint: None, None
                    size: dp(48), dp(48)
                    radius: [dp(24)]
                    elevation: 0
                    md_bg_color: (0.05, 0.78, 0.70, 1) if root.hd_mode else (0, 0, 0, 0.42)

                    MDFlatButton:
                        text: "HD"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        bold: True
                        font_size: "12sp"
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}
                        on_release: root.toggle_hd()

                MDIconButton:
                    icon: "dots-vertical"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1
                    user_font_size: "25sp"
                    size_hint: None, None
                    size: dp(46), dp(46)
                    on_release: root.open_more()

            # Hint pill — sits close under the top row
            MDCard:
                orientation: "horizontal"
                size_hint: 0.66, None
                height: dp(48)
                pos_hint: {"center_x": 0.5, "top": 0.915}
                radius: [dp(24)]
                elevation: 0
                md_bg_color: 0.09, 0.11, 0.14, 0.72
                padding: dp(16), 0
                spacing: dp(8)

                MDIcon:
                    icon: "scan-helper"
                    theme_text_color: "Custom"
                    text_color: 0.9, 0.91, 0.94, 1
                    size_hint_x: None
                    width: dp(24)

                MDLabel:
                    id: hint_label
                    text: "Point at document & hold steady"
                    halign: "center"
                    valign: "middle"
                    theme_text_color: "Custom"
                    text_color: 0.95, 0.96, 0.98, 1
                    font_style: "Body2"

            MDBoxLayout:
                id: permission_box
                orientation: "vertical"
                size_hint: 0.86, None
                height: dp(170)
                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                spacing: dp(14)
                padding: dp(16)
                opacity: 0
                disabled: True
                md_bg_color: 0.08, 0.08, 0.08, 0.94

                MDLabel:
                    text: "Camera permission is needed to scan documents"
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1

                MDRaisedButton:
                    text: "GRANT PERMISSION"
                    pos_hint: {"center_x": 0.5}
                    on_release: root.request_permission()

        # --- Bottom Controls ---
        MDBoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: dp(200)
            pos_hint: {"bottom": 1}
            padding: dp(10), dp(10), dp(10), dp(8)
            spacing: dp(4)
            md_bg_color: 0, 0, 0, 0.6

            # Single / Batch pill toggle (white capsule behind active option)
            MDCard:
                size_hint: None, None
                size: dp(190), dp(40)
                pos_hint: {"center_x": 0.5}
                radius: [dp(20)]
                elevation: 0
                md_bg_color: 0.16, 0.17, 0.19, 0.85
                padding: dp(3)

                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: dp(3)

                    MDCard:
                        radius: [dp(17)]
                        elevation: 0
                        md_bg_color: (1, 1, 1, 1) if root.capture_mode == "single" else (0, 0, 0, 0)

                        MDFlatButton:
                            text: "Single"
                            theme_text_color: "Custom"
                            text_color: (0, 0, 0, 1) if root.capture_mode == "single" else (0.85, 0.85, 0.85, 1)
                            bold: True
                            pos_hint: {"center_x": 0.5, "center_y": 0.5}
                            on_release: root.select_capture_mode("single")

                    MDCard:
                        radius: [dp(17)]
                        elevation: 0
                        md_bg_color: (1, 1, 1, 1) if root.capture_mode == "batch" else (0, 0, 0, 0)

                        MDFlatButton:
                            text: "Batch"
                            theme_text_color: "Custom"
                            text_color: (0, 0, 0, 1) if root.capture_mode == "batch" else (0.85, 0.85, 0.85, 1)
                            bold: True
                            pos_hint: {"center_x": 0.5, "center_y": 0.5}
                            on_release: root.select_capture_mode("batch")

            MDBoxLayout:
                orientation: "horizontal"
                adaptive_width: True
                size_hint_y: None
                height: dp(34)
                spacing: dp(20)
                pos_hint: {"center_x": 0.5}

                MDFlatButton:
                    text: "Scan"
                    theme_text_color: "Custom"
                    text_color: (0.20, 0.85, 0.35, 1) if root.scan_type == "scan" else (0.72, 0.72, 0.72, 1)
                    on_release: root.select_scan_type("scan")

                MDFlatButton:
                    text: "ID Cards"
                    theme_text_color: "Custom"
                    text_color: (0.20, 0.85, 0.35, 1) if root.scan_type == "id_card" else (0.72, 0.72, 0.72, 1)
                    on_release: root.select_scan_type("id_card")

            MDBoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: dp(120)
                padding: dp(6), dp(2)

                # Left: All Features
                MDBoxLayout:
                    orientation: "vertical"
                    size_hint_x: 1
                    spacing: 0

                    MDIconButton:
                        icon: "view-grid-outline"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        user_font_size: "25sp"
                        pos_hint: {"center_x": 0.5}
                        on_release: root.open_all_features()

                    MDLabel:
                        text: "All Features"
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: 0.82, 0.82, 0.82, 1
                        font_style: "Caption"

                # Center: shutter button + progress ring
                FloatLayout:
                    size_hint_x: 1

                    Widget:
                        id: auto_ring
                        size_hint: None, None
                        size: dp(88), dp(88)
                        pos_hint: {"center_x": 0.5, "center_y": 0.52}
                        canvas:
                            Color:
                                rgba: 0.12, 0.88, 0.67, 0.96
                            Line:
                                circle: (self.center_x, self.center_y, self.width / 2 - dp(2), -90, -90 + 360 * root.ring_progress)
                                width: dp(3)
                                cap: "round"

                    MDFloatingActionButton:
                        id: shutter_button
                        icon: "camera"
                        md_bg_color: 1, 1, 1, 1
                        theme_text_color: "Custom"
                        text_color: 0, 0, 0, 1
                        user_font_size: "32sp"
                        disabled: root.capture_busy
                        pos_hint: {"center_x": 0.5, "center_y": 0.52}
                        on_release: root.capture()

                # Right: Images + Files grouped together
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_x: 1
                    spacing: dp(4)

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: 0

                        MDIconButton:
                            icon: "image-outline"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            user_font_size: "25sp"
                            pos_hint: {"center_x": 0.5}
                            on_release: root.pick_image()

                        MDLabel:
                            text: "Images"
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: 0.82, 0.82, 0.82, 1
                            font_style: "Caption"

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: 0

                        MDIconButton:
                            icon: "folder-outline"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            user_font_size: "25sp"
                            pos_hint: {"center_x": 0.5}
                            on_release: root.pick_pdf()

                        MDLabel:
                            text: "Files"
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: 0.82, 0.82, 0.82, 1
                            font_style: "Caption"

                    # Page counter only shows in batch mode, tucked under Files
                    MDLabel:
                        text: root.page_count_text
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        halign: "center"
                        font_style: "Caption"
                        size_hint: None, None
                        size: dp(40), dp(16)
                        opacity: 1 if root.capture_mode == "batch" else 0
