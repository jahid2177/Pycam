#:import dp kivy.metrics.dp

<ScannerScreen>:
    camera_container: camera_container
    permission_box: permission_box
    shutter_button: shutter_button
    hint_label: hint_label
    top_bar: top_bar
    auto_ring: auto_ring

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0, 0, 0, 1

        MDTopAppBar:
            id: top_bar
            title: "Scan Document"
            elevation: 0
            md_bg_color: 0, 0, 0, 1
            specific_text_color: 1, 1, 1, 1
            left_action_items: [["arrow-left", lambda x: root.close_scanner()]]
            right_action_items: [["flash-off", lambda x: root.toggle_flash()], ["timer-outline", lambda x: root.toggle_auto_capture()]]

        FloatLayout:
            id: camera_container

            MDLabel:
                id: hint_label
                text: "Point the camera at a document"
                halign: "center"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                size_hint: 0.92, None
                height: dp(42)
                pos_hint: {"center_x": 0.5, "top": 0.985}
                font_style: "Body1"
                canvas.before:
                    Color:
                        rgba: 0, 0, 0, 0.42
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(10)]

            MDBoxLayout:
                id: permission_box
                orientation: "vertical"
                size_hint: 0.86, None
                height: dp(170)
                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                spacing: dp(14)
                padding: dp(16)
                opacity: 0
                disabled: True
                md_bg_color: 0.08, 0.08, 0.08, 0.92

                MDLabel:
                    text: "Camera permission is needed to scan documents"
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1

                MDRaisedButton:
                    text: "GRANT PERMISSION"
                    pos_hint: {"center_x": 0.5}
                    on_release: root.request_permission()

        # ------------------------------------------------------------
        # Bottom scanner controls - modeled after the supplied example.
        # ------------------------------------------------------------
        MDBoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: dp(196)
            padding: dp(14), dp(6), dp(14), dp(10)
            spacing: dp(4)
            md_bg_color: 0, 0, 0, 1

            # Single / Batch
            MDBoxLayout:
                orientation: "horizontal"
                adaptive_width: True
                size_hint_y: None
                height: dp(36)
                spacing: dp(4)
                pos_hint: {"center_x": 0.5}

                MDRectangleFlatButton:
                    text: "Single"
                    theme_text_color: "Custom"
                    text_color: (0.20, 0.85, 0.35, 1) if root.capture_mode == "single" else (0.75, 0.75, 0.75, 1)
                    line_color: (0.20, 0.85, 0.35, 1) if root.capture_mode == "single" else (0.25, 0.25, 0.25, 1)
                    on_release: root.select_capture_mode("single")

                MDRectangleFlatButton:
                    text: "Batch"
                    theme_text_color: "Custom"
                    text_color: (0.20, 0.85, 0.35, 1) if root.capture_mode == "batch" else (0.75, 0.75, 0.75, 1)
                    line_color: (0.20, 0.85, 0.35, 1) if root.capture_mode == "batch" else (0.25, 0.25, 0.25, 1)
                    on_release: root.select_capture_mode("batch")

            # Scan / ID Cards
            MDBoxLayout:
                orientation: "horizontal"
                adaptive_width: True
                size_hint_y: None
                height: dp(34)
                spacing: dp(22)
                pos_hint: {"center_x": 0.5}

                MDFlatButton:
                    text: "Scan"
                    theme_text_color: "Custom"
                    text_color: (0.20, 0.85, 0.35, 1) if root.scan_type == "scan" else (0.72, 0.72, 0.72, 1)
                    on_release: root.select_scan_type("scan")

                MDFlatButton:
                    text: "ID Cards"
                    theme_text_color: "Custom"
                    text_color: (0.20, 0.85, 0.35, 1) if root.scan_type == "id_card" else (0.72, 0.72, 0.72, 1)
                    on_release: root.select_scan_type("id_card")

            # Gallery / Capture / Page count
            MDBoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: dp(106)
                padding: dp(14), dp(5)
                spacing: dp(10)

                FloatLayout:
                    size_hint_x: 1

                    MDIconButton:
                        icon: "image-multiple-outline"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        user_font_size: "28sp"
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}
                        on_release: root.go_to_pages()

                FloatLayout:
                    size_hint_x: 1

                    Widget:
                        id: auto_ring
                        size_hint: None, None
                        size: dp(88), dp(88)
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}
                        canvas:
                            Color:
                                rgba: 0.20, 0.85, 0.35, 0.96
                            Line:
                                circle: (self.center_x, self.center_y, self.width / 2 - dp(2), -90, -90 + 360 * root.ring_progress)
                                width: dp(3)
                                cap: "round"

                    MDFloatingActionButton:
                        id: shutter_button
                        icon: "camera"
                        md_bg_color: 1, 1, 1, 1
                        theme_text_color: "Custom"
                        text_color: 0, 0, 0, 1
                        user_font_size: "32sp"
                        disabled: root.capture_busy
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}
                        on_release: root.capture()

                FloatLayout:
                    size_hint_x: 1

                    MDLabel:
                        text: root.page_count_text
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        halign: "center"
                        valign: "middle"
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}
