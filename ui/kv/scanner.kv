#:import dp kivy.metrics.dp

<ScannerScreen>:
    camera_container: camera_container
    permission_box: permission_box
    shutter_button: shutter_button
    hint_label: hint_label
    top_bar: top_bar
    auto_ring: auto_ring

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0, 0, 0, 1

        MDTopAppBar:
            id: top_bar
            title: "Scan Document"
            elevation: 0
            md_bg_color: 0, 0, 0, 1
            specific_text_color: 1, 1, 1, 1
            left_action_items: [["arrow-left", lambda x: root.close_scanner()]]
            right_action_items: [["flash-off", lambda x: root.toggle_flash()], ["timer-outline", lambda x: root.toggle_auto_capture()]]

        # Camera preview starts immediately below the toolbar.  The hint
        # is an overlay, not a separate black header, so no extra empty
        # black area is reserved above the preview.
        FloatLayout:
            id: camera_container

            MDLabel:
                id: hint_label
                text: "Point the camera at a document"
                halign: "center"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                size_hint: 0.88, None
                height: dp(38)
                pos_hint: {"center_x": 0.5, "top": 0.985}
                font_style: "Body1"
                canvas.before:
                    Color:
                        rgba: 0, 0, 0, 0.35
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(12)]

            MDBoxLayout:
                id: permission_box
                orientation: "vertical"
                size_hint: 0.86, None
                height: dp(170)
                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                spacing: dp(14)
                padding: dp(16)
                opacity: 0
                disabled: True
                md_bg_color: 0.08, 0.08, 0.08, 0.92

                MDLabel:
                    text: "Camera permission is needed to scan documents"
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1

                MDRaisedButton:
                    text: "GRANT PERMISSION"
                    pos_hint: {"center_x": 0.5}
                    on_release: root.request_permission()

        MDBoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: dp(190)
            padding: dp(10), dp(4), dp(10), dp(8)
            spacing: dp(2)
            md_bg_color: 0, 0, 0, 1

            MDBoxLayout:
                orientation: "horizontal"
                adaptive_width: True
                size_hint_y: None
                height: dp(34)
                spacing: dp(4)
                pos_hint: {"center_x": 0.5}

                MDRectangleFlatButton:
                    text: "Single"
                    theme_text_color: "Custom"
                    text_color: (0.20, 0.85, 0.35, 1) if root.capture_mode == "single" else (0.75, 0.75, 0.75, 1)
                    line_color: (0.20, 0.85, 0.35, 1) if root.capture_mode == "single" else (0.25, 0.25, 0.25, 1)
                    on_release: root.select_capture_mode("single")

                MDRectangleFlatButton:
                    text: "Batch"
                    theme_text_color: "Custom"
                    text_color: (0.20, 0.85, 0.35, 1) if root.capture_mode == "batch" else (0.75, 0.75, 0.75, 1)
                    line_color: (0.20, 0.85, 0.35, 1) if root.capture_mode == "batch" else (0.25, 0.25, 0.25, 1)
                    on_release: root.select_capture_mode("batch")

            MDBoxLayout:
                orientation: "horizontal"
                adaptive_width: True
                size_hint_y: None
                height: dp(34)
                spacing: dp(20)
                pos_hint: {"center_x": 0.5}

                MDFlatButton:
                    text: "Scan"
                    theme_text_color: "Custom"
                    text_color: (0.20, 0.85, 0.35, 1) if root.scan_type == "scan" else (0.72, 0.72, 0.72, 1)
                    on_release: root.select_scan_type("scan")

                MDFlatButton:
                    text: "ID Cards"
                    theme_text_color: "Custom"
                    text_color: (0.20, 0.85, 0.35, 1) if root.scan_type == "id_card" else (0.72, 0.72, 0.72, 1)
                    on_release: root.select_scan_type("id_card")

            MDBoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: dp(112)
                padding: dp(4), dp(3)
                spacing: dp(4)

                # Left side: Images + Files exactly beside the capture button.
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_x: 1.25
                    spacing: dp(2)

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: 0

                        MDIconButton:
                            icon: "image-outline"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            user_font_size: "25sp"
                            pos_hint: {"center_x": 0.5}
                            on_release: root.pick_image()

                        MDLabel:
                            text: "Images"
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: 0.82, 0.82, 0.82, 1
                            font_style: "Caption"

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: 0

                        MDIconButton:
                            icon: "folder-outline"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            user_font_size: "25sp"
                            pos_hint: {"center_x": 0.5}
                            on_release: root.pick_pdf()

                        MDLabel:
                            text: "Files"
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: 0.82, 0.82, 0.82, 1
                            font_style: "Caption"

                FloatLayout:
                    size_hint_x: 1

                    Widget:
                        id: auto_ring
                        size_hint: None, None
                        size: dp(88), dp(88)
                        pos_hint: {"center_x": 0.5, "center_y": 0.52}
                        canvas:
                            Color:
                                rgba: 0.20, 0.85, 0.35, 0.96
                            Line:
                                circle: (self.center_x, self.center_y, self.width / 2 - dp(2), -90, -90 + 360 * root.ring_progress)
                                width: dp(3)
                                cap: "round"

                    MDFloatingActionButton:
                        id: shutter_button
                        icon: "camera"
                        md_bg_color: 1, 1, 1, 1
                        theme_text_color: "Custom"
                        text_color: 0, 0, 0, 1
                        user_font_size: "32sp"
                        disabled: root.capture_busy
                        pos_hint: {"center_x": 0.5, "center_y": 0.52}
                        on_release: root.capture()

                FloatLayout:
                    size_hint_x: 1.25

                    MDLabel:
                        text: root.page_count_text
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        halign: "center"
                        valign: "middle"
                        pos_hint: {"center_x": 0.5, "center_y": 0.52}
